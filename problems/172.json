  "audienceLevel": "M-7",
  "apcsLevel": null,
  "platformMode": "Python",
  "learningObjectives": [
    "用列與欄的位置辨識圖形邊界",
    "處理高度或寬度為一的退化圖形"
  ],
  "prerequisites": [
    "巢狀迴圈",
    "or 條件",
    "字串組合"
  ],
  "description": "<p class='problem-lead'>以井字號與句點印出指定大小的空心方框。</p><p>方框高 H 列、寬 W 欄。最上列、最下列、最左欄與最右欄都印 <code>#</code>，其餘位置印 <code>.</code>。若 H 或 W 為 1，每個位置都在邊界上。</p>",
  "hint": "<p>某位置只要位於四條邊中的任一條，就屬於邊界。</p>",
  "inputFormat": "<p>一行包含正整數 H 與 W，以空白分隔。</p>",
  "outputFormat": "<p>輸出 H 行，每行恰有 W 個字元。字元之間不加空白。</p>",
  "constraints": "<ul><li>1 ≤ H、W ≤ 30</li></ul>",
  "timeLimit": 1,
  "memoryLimit": 256,
  "sampleInput": "4 5",
  "sampleOutput": "#####\n#...#\n#...#\n#####",
  "samples": [
    {
      "input": "4 5",
      "output": "#####\n#...#\n#...#\n#####"
    },
    {
      "input": "1 1",
      "output": "#"
    },
    {
      "input": "3 3",
      "output": "###\n#.#\n###"
    }
  ],
