  "platformMode": "Python",
  "learningObjectives": [
    "讀取位數不固定的次數",
    "依字母與次數還原字串"
  ],
  "prerequisites": [
    "字串索引",
    "while 迴圈",
    "整數轉換"
  ],
  "description": "<p class='problem-lead'>將字母後的重複次數展開為完整指令。</p><p>輸入由一或多組「大寫字母＋正整數」直接串接而成。例如 <code>A3B12</code> 表示先輸出 3 個 A，再輸出 12 個 B。相鄰兩組可使用相同字母，每一組仍按順序展開。</p>",
  "hint": "<p>遇到字母後，持續讀取數字直到下一個字母或字串結尾。</p>",
  "inputFormat": "<p>一行編碼字串，不含空白；每組的次數沒有前導零。</p>",
  "outputFormat": "<p>輸出展開後的字串，不加任何空白。</p>",
  "constraints": "<ul><li>1 ≤ 組數 ≤ 100</li><li>每組字母為 A–Z，每組次數為 1 至 20</li><li>輸入保證符合編碼格式；展開後長度最多 2000</li></ul>",
  "timeLimit": 1,
  "memoryLimit": 256,
  "sampleInput": "A3B2A1",
  "sampleOutput": "AAABBA",
  "samples": [
    {
      "input": "A3B2A1",
      "output": "AAABBA"
    },
    {
      "input": "Z1",
      "output": "Z"
    },
    {
      "input": "A10B1",
      "output": "AAAAAAAAAAB"
    }
  ],
